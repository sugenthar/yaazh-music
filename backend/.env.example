# Server
PORT=3000
NODE_ENV=development

# Database (SQLite, user data only)
DB_PATH=data/yaazh.db

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Music catalog - Audius provider
AUDIUS_API_BASE_URL=https://api.audius.co
AUDIUS_API_KEY=

# Music catalog - GitHub fallback (JSON URL with songs array)
GITHUB_SONGS_URL=
GITHUB_SONGS_DEFAULT=

# CORS
CORS_ORIGIN=*

# Cache
CACHE_TTL_MS=300000
CACHE_STALE_TTL_MS=1800000
CACHE_MAX_SIZE=1000

# Provider resilience
REQUEST_TIMEOUT_MS=15000
MAX_RETRIES=2
PROVIDER_COOLDOWN_MS=30000
PROVIDER_FAILURE_THRESHOLD=3

# Rate limiting
RATE_LIMIT_GENERAL_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=20

# Request limits
MAX_BODY_BYTES=1000000

# Features
ENABLE_STALE_WHILE_REVALIDATE=true
APP_NAME=yaazh-music

# ============ Horizontal scalability (optional) ============

# Distributed caching, distributed rate limiting, shared job queue and worker
# coordination. Redis is NOT exposed publicly and the API degrades gracefully
# to memory-only when unset or unavailable.
REDIS_URL=
# Prefix for keys this app owns (set a unique value per environment/deployment)
REDIS_KEY_PREFIX=yaazh
# Each instance gets a unique id automatically; pin it explicitly for clarity in
# logs and metrics (e.g. api-a, api-b).
INSTANCE_ID=

# Redis connection/command timeouts (ms). Keep them low so a slow Redis never
# blocks the request path for long; the app falls back to memory on failure.
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=2000

# Reverse proxy (nginx/ELB). Set TRUST_PROXY=true so client IPs are correct for
# rate limiting when the app sits behind a reverse proxy. Hop count = number of
# trusted proxies in front of the app.
TRUST_PROXY=false
TRUST_PROXY_HOP_COUNT=1

# Background worker (e.g. distributed metrics flush, notifications). Processed
# in-process when Redis is absent; coordinated across instances via Redis.
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_MS=1000
WORKER_RETRY_MAX=3

# Database backup / recovery (online SQLite backup + rotation)
BACKUP_DIR=data/backups
BACKUP_RETENTION_DAYS=7
BACKUP_INTERVAL_HOURS=24
