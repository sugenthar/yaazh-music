# Server
PORT=3000
NODE_ENV=development

# Database (SQLite, user data only)
DB_PATH=data/yaazh.db

# Authentication
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Music catalog - Audius provider
# Open Audius API. Optional API key if you register an app with Audius.
AUDIUS_API_BASE_URL=https://api.audius.co
AUDIUS_API_KEY=

# CORS
CORS_ORIGIN=*